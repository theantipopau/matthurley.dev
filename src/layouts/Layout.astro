---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import { getStarTotal, getProjectCount } from '../data/github';
import { jsAsset } from '../data/build';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = "matthurley.dev builds practical, privacy-first software for education, hardware, and operations teams — led by Matt Hurley.",
  jsonLd
} = Astro.props;

const [starTotal, projectCount] = await Promise.all([getStarTotal(), getProjectCount()]);

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const fontUrl = 'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600;700&display=swap';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="author" content="Matt Hurley">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()">
  <title>{title}</title>
  <link rel="canonical" href={`https://matthurley.dev${currentPath}`}>

  <link rel="icon" type="image/svg+xml" href="/brand/favicon-icon.svg">
  <link rel="icon" type="image/png" href="/brand/icon-192.png">
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0a0908">

  <meta property="og:type" content="website">
  <meta property="og:url" content={`https://matthurley.dev${currentPath}`}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://matthurley.dev/brand/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://matthurley.dev/brand/og-image.png">
  <script is:inline src={jsAsset('early.js')}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={fontUrl} rel="stylesheet">

  <ViewTransitions />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  )}

  <script defer data-domain="matthurley.dev" src="https://plausible.io/js/script.js"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="scroll-progress"></div>

  <header class="site-header">
    <div class="header-content container-wide">
      <a href="/" class="site-branding" aria-label="matthurley.dev home">
        <Logo variant="mark" class="logo-mark" />
        <Logo variant="full" class="logo-word" />
      </a>

      <nav aria-label="Primary" id="primary-nav">
        <ul>
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={isActive(item.href) ? 'active' : ''}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-actions">
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle colour theme" title="Toggle theme (T)">
          <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
          </svg>
          <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 14.4A8.6 8.6 0 0 1 9.6 3.5a8.6 8.6 0 1 0 10.9 10.9Z"></path>
          </svg>
        </button>
        <a href="/contact" class="nav-cta">Start a project</a>
        <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container-wide">
      <div class="footer-grid">
        <div>
          <a href="/" class="footer-brand" aria-label="matthurley.dev home">
            <Logo variant="full" class="logo-word" />
          </a>
          <p class="footer-tagline">Practical, privacy-first software for education, hardware, and operations teams — designed, built, and maintained end to end.</p>
          <p class="pill-row mt-3">
            <span class="star-badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.6 2.9 5.9 6.5.95-4.7 4.6 1.1 6.5L12 17.45 6.2 20.5l1.1-6.5-4.7-4.6 6.5-.95L12 2.6Z"/></svg>
              <span data-count-to={starTotal}>0</span> stars
            </span>
            <span class="pill soft">{projectCount} public repos</span>
          </p>
        </div>
        <div class="footer-col">
          <h4>Site</h4>
          <ul>
            <li><a href="/projects">Work</a></li>
            <li><a href="/writing">Writing</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Live Products</h4>
          <ul>
            <li><a href="https://hurleycomputers.au" target="_blank" rel="noopener noreferrer">Hurley Computers ↗</a></li>
            <li><a href="https://playbrightbound.matthurley.dev" target="_blank" rel="noopener noreferrer">BrightBound Adventures ↗</a></li>
            <li><a href="https://demo.sophiastars.info" target="_blank" rel="noopener noreferrer">STARS Demo ↗</a></li>
            <li><a href="https://theantipopau.github.io/southernspear-site/" target="_blank" rel="noopener noreferrer">Southern Spear ↗</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <ul>
            <li><a href="mailto:matt@matthurley.dev">matt@matthurley.dev</a></li>
            <li><a href="https://github.com/theantipopau" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="https://www.linkedin.com/in/matt-hurley-29471a149/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href="https://www.paypal.com/donate/?business=XH8CKYF8T7EBU" target="_blank" rel="noopener noreferrer">☕ Buy me a coffee</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-meta">
        <span>&copy; {new Date().getFullYear()} matthurley.dev — All rights reserved.</span>
        <span>Based in South East Queensland, Australia</span>
      </div>
    </div>
  </footer>

  <button id="back-to-top" class="back-to-top" aria-label="Back to top">Top</button>
  <script defer src={jsAsset('site.js')}></script>
</body>
</html>

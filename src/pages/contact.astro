---
import Layout from '../layouts/Layout.astro';
import { jsAsset } from '../data/build';

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact matthurley.dev',
  url: 'https://matthurley.dev/contact'
};
---

<Layout
  title="Contact | matthurley.dev"
  description="Start a project conversation with matthurley.dev — practical, privacy-first software for education, hardware, and operations teams."
  jsonLd={contactJsonLd}
>
  <div class="container page-shell">
    <section class="page-hero reveal">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk about what your system actually needs.</h1>
      <p class="lead">
        I take on a small number of projects at a time, so I read every message myself. Tell me what the system
        needs to do, who has to rely on it, and I'll give you a straight answer on whether it's a fit.
      </p>
      <div class="button-row">
        <a href="mailto:matt@matthurley.dev" class="button primary">Email matt@matthurley.dev</a>
        <button id="copy-email" class="copy-email" type="button">Copy Email</button>
      </div>
    </section>

    <section class="contact-grid reveal">
      <a href="mailto:matt@matthurley.dev" class="contact-card">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5"></rect><path d="m3.5 6.5 8.5 7 8.5-7"></path></svg>
        </span>
        <h3>Email</h3>
        <p>matt@matthurley.dev</p>
      </a>

      <a href="https://github.com/theantipopau" target="_blank" rel="noopener noreferrer" class="contact-card">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5a10.5 10.5 0 0 0-3.32 20.47c.53.1.72-.23.72-.5v-1.95c-2.92.63-3.54-1.28-3.54-1.28-.48-1.22-1.17-1.54-1.17-1.54-.96-.65.07-.64.07-.64 1.06.07 1.62 1.09 1.62 1.09.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.67-1.4-2.33-.27-4.78-1.16-4.78-5.18 0-1.15.41-2.08 1.08-2.82-.11-.27-.47-1.34.1-2.8 0 0 .88-.28 2.89 1.08a10 10 0 0 1 5.26 0c2-1.36 2.89-1.08 2.89-1.08.57 1.46.21 2.53.1 2.8.68.74 1.08 1.67 1.08 2.82 0 4.03-2.45 4.9-4.79 5.17.38.33.72.97.72 1.96v2.9c0 .27.19.61.73.5A10.5 10.5 0 0 0 12 1.5Z"></path></svg>
        </span>
        <h3>GitHub</h3>
        <p>@theantipopau</p>
      </a>

      <a href="https://www.linkedin.com/in/matt-hurley-29471a149/" target="_blank" rel="noopener noreferrer" class="contact-card">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20.5H6.94V8.5Z"></path><path d="M5.25 3.5a1.97 1.97 0 1 0 0 3.94 1.97 1.97 0 0 0 0-3.94Z"></path><path d="M9.75 8.5h3.24v1.64h.05c.45-.86 1.56-1.77 3.21-1.77 3.43 0 4.06 2.26 4.06 5.2v6.93h-3.38v-6.15c0-1.47-.03-3.36-2.05-3.36-2.05 0-2.37 1.6-2.37 3.25v6.26H9.75V8.5Z"></path></svg>
        </span>
        <h3>LinkedIn</h3>
        <p>Matt Hurley</p>
      </a>
    </section>

    <section class="surface reveal">
      <h2>What to include</h2>
      <p class="section-intro">The faster I understand the real shape of the problem, the faster you get a useful answer.</p>
      <div class="feature-grid">
        <div class="feature-card">
          <span class="feature-icon">01</span>
          <h3>What the system needs to do</h3>
          <p>The actual job, not the feature list — what breaks today, or what doesn't exist yet.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">02</span>
          <h3>Who has to rely on it</h3>
          <p>Staff, customers, or the public — and what happens if it's unavailable for a day.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">03</span>
          <h3>Any hard constraints</h3>
          <p>Governance, budget, timeline, or existing systems it has to work alongside.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">04</span>
          <h3>What "done" looks like</h3>
          <p>Even a rough version helps — it's easier to scope a project against a real outcome.</p>
        </div>
      </div>
    </section>

    <section class="support-banner reveal">
      <h2 class="mb-3">Response times</h2>
      <p>
        I respond to genuine project inquiries personally, usually within a few business days. Response time can
        vary with school and project commitments, but every clear, thoughtful message gets read and answered.
      </p>
      <p class="muted mb-0">This channel is not for generic sales outreach or unsolicited SEO/marketing pitches.</p>
    </section>
  </div>

  <script defer src={jsAsset('contact.js')}></script>
</Layout>

---
import Layout from '../layouts/Layout.astro';

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Matt Hurley',
    description: 'Assistant Principal, educator, and software developer focused on practical systems and privacy-first architecture.',
    url: 'https://matthurley.dev/about'
  }
};
---

<Layout
  title="About | Matt Hurley"
  description="Assistant Principal, educator, and software developer focused on practical systems and privacy-first architecture."
  jsonLd={aboutJsonLd}
>
  <div class="container page-shell">
    <section class="page-hero hero-split reveal">
      <div>
        <p class="eyebrow">About</p>
        <h1>Education leadership and software engineering, connected by systems thinking.</h1>
        <p class="lead">
          I work in senior leadership at a Catholic secondary school in South East Queensland while
          building software that addresses genuine operational problems.
        </p>
      </div>
      <div class="hero-media">
        <img src="/matth.jpg" alt="Portrait of Matt Hurley" class="portrait-photo" decoding="async">
      </div>
    </section>

    <section class="surface reveal">
      <h2>Professional Context</h2>
      <p>
        Across more than a decade in education, I have worked from classroom teaching through to pastoral and senior
        leadership roles. The consistent focus has been improving student engagement and staff capability through
        systems that are clear, reliable, and sustainable.
      </p>
      <p class="muted mb-0">
        The same mindset drives my development work: practical architecture, explicit constraints, and measurable utility.
      </p>
    </section>

    <section class="surface reveal">
      <h2>Background and Experience</h2>
      <div class="highlight-grid">
        <article class="topic-card">
          <h3>Education Leadership</h3>
          <p>Pastoral and assistant principal responsibilities across wellbeing, engagement, and operational systems.</p>
        </article>
        <article class="topic-card">
          <h3>Military Service</h3>
          <p>Service in the Australian Army built a strong foundation in discipline, responsibility, and decision-making under pressure.</p>
        </article>
        <article class="topic-card">
          <h3>Technical Development</h3>
          <p>Independent software projects spanning educational platforms, hardware tools, and privacy-preserving utilities.</p>
        </article>
        <article class="topic-card">
          <h3>Ongoing Learning</h3>
          <p>Postgraduate leadership studies and continued professional development in cybersecurity and system design.</p>
        </article>
      </div>
    </section>

    <section class="surface reveal">
      <h2>Core Values</h2>
      <div class="value-grid">
        <article class="value-card">
          <span class="value-icon">1</span>
          <h3>People First</h3>
          <p>Technology should reduce burden and improve outcomes for real users, not introduce complexity for its own sake.</p>
        </article>
        <article class="value-card">
          <span class="value-icon">2</span>
          <h3>Privacy by Default</h3>
          <p>Data protection should be built into architecture from the start, not retrofitted after deployment.</p>
        </article>
        <article class="value-card">
          <span class="value-icon">3</span>
          <h3>Practical Systems</h3>
          <p>Good solutions account for staffing realities, governance requirements, and long-term maintainability.</p>
        </article>
        <article class="value-card">
          <span class="value-icon">4</span>
          <h3>Continuous Improvement</h3>
          <p>Refinement is ongoing: observe results, learn from constraints, and iterate deliberately.</p>
        </article>
      </div>
    </section>

    <section class="support-banner reveal">
      <h2 class="mb-3">Location</h2>
      <p class="muted mb-0">Based in South East Queensland, Australia.</p>
    </section>
  </div>
</Layout>

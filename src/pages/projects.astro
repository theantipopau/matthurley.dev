---
import Layout from '../layouts/Layout.astro';

const projectsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Work by matthurley.dev',
  url: 'https://matthurley.dev/projects',
  hasPart: [
    { '@type': 'SoftwareApplication', name: 'STARS', applicationCategory: 'EducationApplication' },
    { '@type': 'SoftwareApplication', name: 'OmenCore', applicationCategory: 'UtilitiesApplication', softwareVersion: '4.3.0' },
    { '@type': 'SoftwareApplication', name: 'Radium PCs Companion', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'RigMateAU', applicationCategory: 'ShoppingApplication' },
    { '@type': 'SoftwareApplication', name: 'BrightBound Adventures', applicationCategory: 'GameApplication' },
    { '@type': 'SoftwareApplication', name: 'RelayDesk', applicationCategory: 'SecurityApplication' },
    { '@type': 'SoftwareApplication', name: 'Slimarr', applicationCategory: 'UtilitiesApplication', softwareVersion: '2.0.0.0' },
    { '@type': 'SoftwareApplication', name: 'Portrait Stats', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'PulseLAN', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'MouseTune', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'Echoes of the Riftwar', applicationCategory: 'GameApplication' },
    { '@type': 'SoftwareApplication', name: 'PageCue', applicationCategory: 'LifestyleApplication' }
  ]
};
---

<Layout
  title="Work | matthurley.dev"
  description="Case studies in practical, privacy-first software: a client-delivered school platform, an open-source hardware utility with 229+ stars, and a premium desktop companion built for a real business."
  jsonLd={projectsJsonLd}
>
  <div class="container-wide page-shell">
    <section class="page-hero reveal">
      <p class="eyebrow">Selected Work</p>
      <h1>Systems built for practical impact, not feature theater.</h1>
      <p class="lead">
        Every project below was shaped by a real operational constraint — a school's governance requirements, a
        laptop that overheats, a business that needed its telemetry to tell the truth. The flagship case studies
        go deep on trade-offs and decisions; everything else shipped is listed further down.
      </p>
      <div class="filter-bar">
        <input id="project-filter" class="filter-input" type="search" placeholder="Search case studies by keyword, stack, or domain" aria-label="Filter case studies">
        <button id="clear-project-filter" class="copy-email" type="button">Clear</button>
      </div>
    </section>

    <section class="section reveal">
      <div class="section-head">
        <p class="eyebrow">Flagship</p>
        <h2>Three systems, three different constraints</h2>
      </div>

      <section class="project-grid" id="stars">
        <article class="project-card project-card-featured" data-project="stars pastoral care education azure pb4l tracking client delivery flagship">
          <div class="project-head">
            <div class="project-identity">
              <img src="/sophia-logo.png" alt="STARS logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">01 / Client Delivery</p>
                <h2>STARS</h2>
                <p class="project-kicker">Student Tracking and Recording System</p>
              </div>
            </div>
            <a href="https://demo.sophiastars.info" target="_blank" rel="noopener noreferrer" class="button secondary">Visit Demo</a>
          </div>

          <div class="pill-row">
            <span class="pill brand">Azure Authentication</span>
            <span class="pill soft">PB4L Framework</span>
            <span class="pill soft">Automated Communication</span>
            <span class="pill warm">Audit Trails</span>
          </div>

          <p>
            STARS is a pastoral care platform built for a school team that needed immediate visibility of student
            wellbeing, behavior trends, and intervention history — without relying on disconnected spreadsheets
            or manual, easily-lost processes.
          </p>

          <div class="project-columns">
            <div>
              <h4>What It Solves</h4>
              <ul>
                <li>Consolidates behavior, affirmations, and incident data into a unified record.</li>
                <li>Automates communication workflows with role-aware escalation paths.</li>
                <li>Gives leaders fast access to high-confidence operational information.</li>
              </ul>
            </div>
            <div>
              <h4>Design Choices</h4>
              <ul>
                <li>Role-based access for staff, leaders, and administrators.</li>
                <li>Privacy-first architecture with explicit governance controls.</li>
                <li>No public data exposure; demo environment uses synthetic information.</li>
              </ul>
            </div>
          </div>

          <div class="quote-box">
            <p class="mb-0">
              "STARS has made our processes significantly more streamlined and the immediacy of information for
              pastoral leaders has been exceptional."
            </p>
            <p class="muted mb-0 mt-3">Mr N, Pastoral Leader</p>
          </div>
        </article>
      </section>

      <section class="project-grid" id="omencore">
        <article class="project-card project-card-featured" data-project="omencore 4.3.0 hp omen victus hardware thermals fan rgb dotnet fan curve safety update linux windows gpu overclock open source flagship architecture automation cli">
          <div class="project-head">
            <div class="project-identity">
              <img src="/omencore-logo.png" alt="OmenCore logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">02 / Open Source</p>
                <h2>OmenCore <span class="pill brand inline-pill-gap">v4.3.0</span></h2>
                <p class="project-kicker">Released 7 September 2026 — hardware control for HP OMEN and Victus laptops</p>
              </div>
            </div>
            <div class="button-row">
              <a href="https://omencore.info" target="_blank" rel="noopener noreferrer" class="button secondary">Website</a>
              <a href="https://github.com/theantipopau/omencore" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
            </div>
          </div>

          <div class="pill-row">
            <span class="pill brand">.NET 8</span>
            <span class="pill soft">Automation Rules Engine</span>
            <span class="pill soft">Windows CLI</span>
            <span class="pill warm">No Outbound Telemetry</span>
          </div>

          <p>
            OmenCore replaces bloated OEM control software with direct hardware controls for fan behavior, thermals,
            power modes, undervolting, and RGB management. With 229+ GitHub stars and an active issue tracker, it has
            shipped 20 releases from v3.4.0 to v4.3.0 since April — each one traced back to real hardware, not a
            roadmap slide.
          </p>

          <div class="release-panel">
            <div>
              <span class="release-label">v4.3.0 focus</span>
              <strong>Automation engine, a Windows CLI, and real field-reported safety fixes</strong>
            </div>
            <div>
              <span class="release-label">Verification</span>
              <strong>1380+/1380+ tests passing across the release</strong>
            </div>
            <div>
              <span class="release-label">Convention</span>
              <strong>Unconfirmed-on-real-hardware fixes are labeled, not claimed done</strong>
            </div>
          </div>

          <div class="project-columns">
            <div>
              <h4>v4.3.0 Highlights</h4>
              <ul>
                <li>Shipped all 7 backend automation trigger types (temperature, idle, process, WiFi network, time, battery, AC power) plus a new lid-close trigger — four had been implemented but deliberately held back for undocumented reasons, two of them with real bugs fixed before promotion.</li>
                <li>New <code>omencore-cli</code> Windows command-line tool — <code>status</code>, <code>fan</code>, <code>performance</code>, <code>keyboard</code>, <code>monitor</code>, <code>config</code>, and <code>daemon</code> — built on the same hardware layer as the GUI, no duplicated logic.</li>
                <li>Extracted 194 files into a standalone <code>OmenCore.Core</code> library, decoupling the hardware/service layer from WPF — the precondition the CLI (and any future headless mode) needed to exist at all.</li>
              </ul>
            </div>
            <div>
              <h4>Real Bugs Fixed From Field Reports</h4>
              <ul>
                <li>A Quiet Safety Monitor temperature trip could silently cascade into switching the user's performance mode — despite its own log message promising the power mode was "retained."</li>
                <li>Built-in RGB "Night Mode" and "Work" lighting scenes silently overrode manually-configured lighting on a hidden schedule, with zero UI to see or disable it — fixed after a Discord report of a keyboard "randomly" turning orange.</li>
                <li>Power Automation force-applied the configured AC/Battery preset on every startup regardless of whether the power source had changed, silently discarding a user's manual mid-session choice.</li>
              </ul>
            </div>
          </div>

          <div class="related-links">
            <p>Source notes</p>
            <ul>
              <li><a href="https://github.com/theantipopau/omencore/releases/tag/v4.3.0" target="_blank" rel="noopener noreferrer">OmenCore v4.3.0 release notes</a></li>
              <li><a href="https://github.com/theantipopau/omencore/blob/main/README.md" target="_blank" rel="noopener noreferrer">Current OmenCore README</a></li>
            </ul>
          </div>
        </article>
      </section>

      <section class="project-grid" id="pccompanion">
        <article class="project-card project-card-featured" data-project="pccompanion radium pcs companion windows telemetry diagnostics maintenance tauri rust react thermal tray support sensor sidecar copilot local llm client product flagship">
          <div class="project-head">
            <div class="project-identity">
              <img src="/radium-logo.png" alt="Radium PCs Companion logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">03 / Client Product</p>
                <h2>Radium PCs Companion <span class="pill warm inline-pill-gap">v0.3</span></h2>
                <p class="project-kicker">Local-first Windows telemetry, diagnostics, and maintenance companion</p>
              </div>
            </div>
            <a href="https://github.com/theantipopau/pccompanion" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
          </div>

          <div class="pill-row">
            <span class="pill brand">Tauri 2 + React 19</span>
            <span class="pill brand">Rust Backend</span>
            <span class="pill soft">Truthful Telemetry</span>
            <span class="pill warm">Local-First</span>
          </div>

          <p>
            Built for Radium PCs customers and technicians, this desktop companion pairs a premium React interface
            with a Rust/Tauri backend, vendor telemetry providers, and a bundled sensor sidecar for hardware that
            needs deeper package-temperature access than user-mode WMI exposes. v0.3 was a deliberate premium-feel
            and reliability pass — no changes to telemetry providers, native write paths, or the safety-gating model.
          </p>

          <div class="project-columns">
            <div>
              <h4>What It Delivers</h4>
              <ul>
                <li>Live dashboard for CPU, GPU, RAM, network, storage, and support-readiness state.</li>
                <li>Premium thermal visualization with vendor-aware component overlays.</li>
                <li>Maintenance tools — bloatware review, registry checks, startup manager, RAM optimizer — and Quiet/Balanced/Creator/Gaming performance profiles.</li>
              </ul>
            </div>
            <div>
              <h4>v0.3 Reliability Pass</h4>
              <ul>
                <li>Fixed a rare panic in the 1Hz hardware monitor loop that could poison a lock and permanently stop telemetry until restart — the loop now recovers instead of cascading.</li>
                <li>Unified every hover/press/transition animation in the app onto one consistent motion system, replacing over a dozen slightly-different one-off timings.</li>
                <li>Truthful telemetry — missing sensors show as degraded or driver-required, never fabricated as zero.</li>
                <li>Fan/EC/firmware writes stay blocked until model-specific safety validation exists.</li>
              </ul>
            </div>
          </div>

          <div class="note">
            <strong>Status:</strong> Public release at v0.3 for Windows 10/11 x64. GPU-vendor-provider expansion,
            sensor-sidecar packaging, and a real in-game frame-time overlay are reviewed and deliberately deferred
            pending access to real target hardware to validate against.
          </div>
        </article>
      </section>
    </section>

    <section class="section reveal">
      <div class="section-head">
        <p class="eyebrow">More Case Studies</p>
        <h2>Live products and systems in active development</h2>
      </div>

      <section class="project-grid" id="hurleycomputers">
        <article class="project-card" data-project="hurley computers custom pc building south east queensland business website static html css contact form quote">
          <div class="project-head">
            <div class="project-identity">
              <span class="project-mono" aria-hidden="true">HC</span>
              <div>
                <h2>Hurley Computers</h2>
                <p class="project-kicker">Boutique custom PC building, South East Queensland</p>
              </div>
            </div>
            <a href="https://hurleycomputers.au" target="_blank" rel="noopener noreferrer" class="button primary">Visit Site</a>
          </div>
          <div class="pill-row">
            <span class="pill brand">Static HTML/CSS/JS</span>
            <span class="pill soft">Spam-Protected Quote Form</span>
            <span class="pill warm">Owned & Operated</span>
          </div>
          <p>
            My own custom PC-building business, built and run alongside the school and software work — every build
            spec'd, sourced, and supported personally, gaming rigs through AI workstations. Same one-person
            accountability the studio runs on, just with a screwdriver instead of a keyboard.
          </p>
        </article>
      </section>

      <section class="project-grid" id="rigmateau">
        <article class="project-card" data-project="rigmateau rig mate au pc builder price comparison australia compatibility checker marketplace trust scoring nextjs cloudflare workers open source">
          <div class="project-head">
            <div class="project-identity">
              <img src="/icon.PNG" alt="RigMateAU icon" class="project-logo" loading="lazy" decoding="async">
              <div>
                <h2>RigMateAU</h2>
                <p class="project-kicker">Australia-focused PC builder and price-comparison platform</p>
              </div>
            </div>
            <div class="button-row">
              <a href="/projects/rigmateau" class="button secondary">Case Study</a>
              <a href="https://rigmateau.matt-hurley91.workers.dev/" target="_blank" rel="noopener noreferrer" class="button primary">Visit Website</a>
            </div>
          </div>
          <div class="pill-row">
            <span class="pill brand">Next.js</span>
            <span class="pill brand">Cloudflare Workers</span>
            <span class="pill soft">Compatibility Engine</span>
            <span class="pill warm">Live Project</span>
          </div>
          <p>
            A full PC builder and price-comparison platform for Australian buyers, with compatibility checks,
            trust-aware marketplace scoring, and premium shareable build pages — deliberately excluding OzBargain
            and Whirlpool from any scraping, importing, or pricing pipeline.
          </p>
        </article>
      </section>

      <section class="project-grid" id="brightbound">
        <article class="project-card" data-project="brightbound app education literacy numeracy flutter offline child safe">
          <div class="project-head">
            <div class="project-identity">
              <img src="/bb-logo.png" alt="BrightBound logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <h2>BrightBound Adventures</h2>
                <p class="project-kicker">Offline-first educational game platform for children</p>
              </div>
            </div>
            <div class="button-row">
              <a href="https://playbrightbound.matthurley.dev" target="_blank" rel="noopener noreferrer" class="button primary">Play Now</a>
              <a href="https://github.com/theantipopau/brightbound_adventures" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
            </div>
          </div>
          <div class="pill-row">
            <span class="pill brand">Flutter</span>
            <span class="pill soft">Offline First</span>
            <span class="pill soft">ACARA Aligned</span>
            <span class="pill warm">Child Safe by Default</span>
          </div>
          <p>
            A colourful, offline-first learning RPG for ages 4–12, built for classrooms and homes where reliable
            internet is not guaranteed. Local-first storage, no external telemetry, adaptive difficulty, and a
            currently-active sprint cycle rebuilding the world map into extruded 3D zone islands and closing out
            a reward-transaction system that survives a killed-and-relaunched app without re-earning anything.
          </p>
        </article>
      </section>

      <section class="project-grid" id="relaydesk">
        <article class="project-card" data-project="relaydesk remote desktop access rdp tauri rust axum webrtc signaling crossplatform typescript react broker passkeys">
          <div class="project-head">
            <div class="project-identity">
              <img src="/relay_logo.png" alt="RelayDesk logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <h2>RelayDesk <span class="pill soft inline-pill-gap">Prototype, Paused</span></h2>
                <p class="project-kicker">Secure remote desktop and access platform</p>
              </div>
            </div>
            <a href="https://github.com/theantipopau/relaydesk" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
          </div>
          <div class="pill-row">
            <span class="pill brand">Tauri 2</span>
            <span class="pill brand">Rust + Axum</span>
            <span class="pill soft">WebRTC</span>
            <span class="pill warm">Passkey Auth</span>
          </div>
          <p>
            A secure remote access platform with one desktop app acting as both viewer and host, a browser-based
            web client, and a Rust broker for auth, device registry, and WebSocket signaling. Passkey/WebAuthn-first,
            with the Phase 2 auth, device registry, and signaling contract implemented and verified. Host approval,
            WebRTC negotiation, and the media/data plane are scoped for Phase 3 but currently on hold behind other work.
          </p>
        </article>
      </section>

      <section class="project-grid" id="slimarr">
        <article class="project-card project-card-featured" data-project="slimarr plex usenet sabnzbd media library compression h265 av1 python fastapi react typescript radarr sonarr arr automation discovery recommendations ai">
          <div class="project-head">
            <div class="project-identity">
              <span class="project-mono" aria-hidden="true">SL</span>
              <div>
                <h2>Slimarr <span class="pill warm inline-pill-gap">v2.0.0.0</span></h2>
                <p class="project-kicker">Automated Plex library compression via Usenet</p>
              </div>
            </div>
            <a href="https://github.com/theantipopau/slimarr" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
          </div>
          <div class="pill-row">
            <span class="pill brand">Python + FastAPI</span>
            <span class="pill brand">React + TypeScript</span>
            <span class="pill soft">Discovery & Recommendations</span>
            <span class="pill warm">21+ Stars</span>
          </div>
          <p>
            Scans a Plex library, finds smaller h265/AV1 releases on Usenet, and replaces bloated files overnight —
            with a hard rule that a replacement is never accepted unless it is strictly smaller than the original.
            v2.0.0.0 followed a full backend/frontend audit against the actual implementation, not the README's
            claims about it, and added a deterministic Discovery & Recommendations feature on top.
          </p>
          <div class="project-columns">
            <div>
              <h4>Discovery, Kept Honest</h4>
              <ul>
                <li>Suggests missing collection entries, sequels, and related titles with a transparent, human-readable reason for every suggestion — off by default.</li>
                <li>An optional AI reranking step can only reorder or explain candidates Slimarr already sourced — it cannot invent titles, see your Plex token or file paths, or trigger a download. Every AI-returned ID is re-validated against TMDB before display.</li>
                <li>Sending a recommendation to Radarr or Sonarr is a separate, explicit, duplicate-checked action — never automatic.</li>
              </ul>
            </div>
            <div>
              <h4>Fixed in the Audit Pass</h4>
              <ul>
                <li>SABnzbd error paths could log an API key embedded in a request URL — errors are now redacted before logging.</li>
                <li>A storage path with an embedded <code>..</code> segment could evade NAS-prefix classification, skipping budget and throttle protection entirely.</li>
                <li>A failed orphan-cleanup could still mark its tracking row as cleared before confirming the file removal actually succeeded.</li>
              </ul>
            </div>
          </div>
        </article>
      </section>

      <section class="project-grid" id="portraitstats">
        <article class="project-card" data-project="portrait stats monitor dashboard cpu gpu ram fps rtss librehardwaremonitor tray dotnet csharp secondary display">
          <div class="project-head">
            <div class="project-identity">
              <span class="project-mono" aria-hidden="true">PS</span>
              <div>
                <h2>Portrait Stats <span class="pill warm inline-pill-gap">v0.3</span></h2>
                <p class="project-kicker">A system monitor dashboard, purpose-built for a portrait secondary monitor</p>
              </div>
            </div>
            <a href="https://github.com/theantipopau/portrait-stats" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
          </div>
          <div class="pill-row">
            <span class="pill brand">C# + .NET</span>
            <span class="pill soft">LibreHardwareMonitorLib</span>
            <span class="pill warm">Live FPS via RTSS</span>
          </div>
          <p>
            Built because a spare portrait monitor next to the main display was sitting idle during gaming sessions.
            Portrait Stats fills it with live CPU, GPU, RAM, drive, and FPS telemetry — auto-detecting whichever
            connected display is actually in portrait orientation rather than assuming a fixed monitor index.
          </p>
          <div class="project-columns">
            <div>
              <h4>What It Shows</h4>
              <ul>
                <li>CPU and GPU usage, temperature, clocks, and power draw; motherboard fan RPM for every live header, fastest first, with editable names since most boards won't say which one is the CPU fan.</li>
                <li>Live FPS via RTSS shared memory, top processes by CPU and GPU usage, vendor badges, radial gauges, and sparkline history.</li>
                <li>C: drive temperature, auto-detecting whichever physical disk actually backs the system drive.</li>
              </ul>
            </div>
            <div>
              <h4>Design Notes</h4>
              <ul>
                <li>A self-contained release build — no separate .NET runtime install needed.</li>
                <li>Requires elevation for LibreHardwareMonitorLib's sensor access; auto-starts via a Scheduled Task instead of a normal startup entry, so it launches elevated without a UAC prompt every login.</li>
                <li>Fan RPM is read by briefly launching a separate helper process on a timer rather than holding a sensor connection open continuously — documented as a deliberate architecture trade-off, not an oversight.</li>
              </ul>
            </div>
          </div>
        </article>
      </section>
    </section>

    <section class="section reveal" id="also-shipped">
      <div class="section-head">
        <p class="eyebrow">Also Shipped</p>
        <h2>Smaller tools, built because the gap was real</h2>
        <p class="lead">Not every project needs a case study. These shipped because something specific kept being annoying — narrow scope, on purpose.</p>
      </div>
      <div class="project-spotlight-grid">
        <a href="https://github.com/theantipopau/pulselan" target="_blank" rel="noopener noreferrer" class="spotlight-project">
          <span class="spotlight-label">Open Source</span>
          <h3>PulseLAN</h3>
          <p>Defensive local-network observability desktop app with ntopng integration — discovery, scoped scanning, and advisories only.</p>
        </a>
        <a href="https://github.com/theantipopau/mousetune" target="_blank" rel="noopener noreferrer" class="spotlight-project">
          <span class="spotlight-label">Utility</span>
          <h3>MouseTune</h3>
          <p>Portable DPI and naming utility for generic Bluetooth mice with no manufacturer software.</p>
        </a>
        <a href="https://github.com/theantipopau/echoesofriftwar" target="_blank" rel="noopener noreferrer" class="spotlight-project">
          <span class="spotlight-label">In Development</span>
          <h3>Echoes of the Riftwar</h3>
          <p>Data-driven 3D action RPG built with Babylon.js, inspired by the world of Midkemia.</p>
        </a>
        <a href="https://nbncompare.info" target="_blank" rel="noopener noreferrer" class="spotlight-project">
          <span class="spotlight-label">Live</span>
          <h3>NBN Compare</h3>
          <p>Objective Australian ISP plan comparison with no affiliate bias and no tracking scripts.</p>
        </a>
        <a href="https://github.com/theantipopau/gta5-rockstar-steam-launcher" target="_blank" rel="noopener noreferrer" class="spotlight-project">
          <span class="spotlight-label">v2.0.0</span>
          <h3>Steam Launch Utilities</h3>
          <p>Hands-free Steam launching for Epic Games and Rockstar titles that fight the non-Steam-game model — now covering GTA V Enhanced and RDR2.</p>
        </a>
        <a href="https://github.com/theantipopau/windows11nontouchgamingoptimizer" target="_blank" rel="noopener noreferrer" class="spotlight-project">
          <span class="spotlight-label">Open Source</span>
          <h3>Windows Optimizers</h3>
          <p>Repeatable, reversible PowerShell tuning scripts for touch and gaming systems.</p>
        </a>
        <a href="https://github.com/theantipopau/pagecue" target="_blank" rel="noopener noreferrer" class="spotlight-project">
          <span class="spotlight-label">In Development</span>
          <h3>PageCue</h3>
          <p>Spoiler-safe reading companion — a deterministic validator rejects any AI-generated recap that references anything past your confirmed page.</p>
        </a>
      </div>
    </section>

    <div id="project-filter-empty" class="no-results">No case studies matched your search. Try terms like stars, omencore, radium, hurley computers, rigmateau, brightbound, relaydesk, slimarr, or portrait stats — or browse Also Shipped above.</div>

    <section class="support-banner reveal">

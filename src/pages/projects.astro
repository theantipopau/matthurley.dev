---
import Layout from '../layouts/Layout.astro';
import { getRepos, getLatestReleases, formatReleaseDate } from '../data/github';

const repos = await getRepos();

// Latest release tags, read from the GitHub releases API at build time so
// version pills never go stale. Each has an embedded snapshot fallback.
const releases = await getLatestReleases();
const releasePill = (repo: string, fallbackTag: string) => {
  const rel = releases[repo] ?? null;
  return {
    tag: rel?.tag ?? fallbackTag,
    url: rel?.url ?? `https://github.com/theantipopau/${repo}/releases`,
    date: rel?.publishedAt ? formatReleaseDate(rel.publishedAt) : ''
  };
};
const omencoreRelease = releasePill('omencore', 'v4.4.1');
const slimarrRelease = releasePill('slimarr', 'v2.0.0.1');
const radiumRelease = releasePill('pccompanion', 'v0.3');
const portraitRelease = releasePill('portrait-stats', 'v0.3');
const gta5Release = releasePill('gta5-rockstar-steam-launcher', 'v2.0.0');
const xteveRelease = releasePill('xteve-reborn', 'v3.0.4');
const starIndex: Record<string, number> = Object.fromEntries(
  repos.map((repo) => [repo.name.toLowerCase(), repo.stars])
);
const S = (name: string) => starIndex[name.toLowerCase()] ?? 0;

const starIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.6 2.9 5.9 6.5.95-4.7 4.6 1.1 6.5L12 17.45 6.2 20.5l1.1-6.5-4.7-4.6 6.5-.95L12 2.6Z"/></svg>';

const projectsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Work by matthurley.dev',
  url: 'https://matthurley.dev/projects',
  hasPart: [
    { '@type': 'SoftwareApplication', name: 'Southern Spear', applicationCategory: 'GameApplication' },
    { '@type': 'SoftwareApplication', name: 'STARS', applicationCategory: 'EducationApplication' },
    { '@type': 'SoftwareApplication', name: 'OmenCore', applicationCategory: 'UtilitiesApplication', softwareVersion: omencoreRelease.tag.replace(/^v/, '') },
    { '@type': 'SoftwareApplication', name: 'GridPilot', applicationCategory: 'EducationApplication' },
    { '@type': 'SoftwareApplication', name: 'Aether Control', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'Radium PCs Companion', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'RigMateAU', applicationCategory: 'ShoppingApplication' },
    { '@type': 'SoftwareApplication', name: 'BrightBound Adventures', applicationCategory: 'GameApplication' },
    { '@type': 'SoftwareApplication', name: 'RelayDesk', applicationCategory: 'SecurityApplication' },
    { '@type': 'SoftwareApplication', name: 'Slimarr', applicationCategory: 'UtilitiesApplication', softwareVersion: slimarrRelease.tag.replace(/^v/, '') },
    { '@type': 'SoftwareApplication', name: 'xTeVe Reborn', applicationCategory: 'MultimediaApplication' },
    { '@type': 'SoftwareApplication', name: 'ShelfSignal', applicationCategory: 'ShoppingApplication' },
    { '@type': 'SoftwareApplication', name: 'Portrait Stats', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'PulseLAN', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'MouseTune', applicationCategory: 'UtilitiesApplication' },
    { '@type': 'SoftwareApplication', name: 'Echoes of the Riftwar', applicationCategory: 'GameApplication' },
    { '@type': 'SoftwareApplication', name: 'PageCue', applicationCategory: 'LifestyleApplication' }
  ]
};

const chips = [
  { key: 'all', label: 'All work' },
  { key: 'case', label: 'Case studies' },
  { key: 'oss', label: 'Open source' },
  { key: 'game', label: 'Games' },
  { key: 'live', label: 'Live products' },
  { key: 'dev', label: 'In development' }
];
---

<Layout
  title="Work | matthurley.dev"
  description={`Case studies in practical, privacy-first software: Southern Spear's tactical FPS, a client-delivered school platform, an open-source hardware utility with ${S('omencore')}+ stars, and a premium desktop companion built for a real business.`}
  jsonLd={projectsJsonLd}
>
  <div class="container-wide page-shell">
    <section class="page-hero reveal">
      <p class="eyebrow">Selected Work</p>
      <h1 data-split>Systems built for <span class="text-gradient">practical impact</span>, not feature theater.</h1>
      <p class="lead">
        Every project below was shaped by a real operational constraint — a school's governance requirements, a
        laptop that overheats, a business that needed its telemetry to tell the truth, or a game that had to be
        fair before it was fun. The flagship case studies go deep on trade-offs and decisions; everything else
        shipped is listed further down, with star counts pulled live from GitHub.
      </p>
      <div class="filter-bar">
        <input id="project-filter" class="filter-input" type="search" placeholder="Search case studies by keyword, stack, or domain" aria-label="Filter case studies">
        <button id="clear-project-filter" class="copy-email" type="button">Clear</button>
      </div>
      <div class="chip-row" role="group" aria-label="Filter by category">
        {chips.map((chip) => (
          <button class="chip" type="button" data-chip={chip.key} aria-pressed={chip.key === 'all' ? 'true' : 'false'}>
            {chip.label}
          </button>
        ))}
      </div>
    </section>

    <section class="section reveal">
      <div class="section-head">
        <p class="eyebrow">Flagship</p>
        <h2>Four systems, four different constraints</h2>
      </div>

      <section class="project-grid" id="southernspear" data-category="game dev">
        <article class="project-card project-card-featured" data-project="southern spear fps unreal engine 5.8 lyra c++ game tactical australian pre-alpha steam multiplayer">
          <div class="project-head">
            <div class="project-identity">
              <img src="/projects/southernspear.webp" alt="Southern Spear logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">01 / Game — In Development</p>
                <h2>Southern Spear <span class="pill warm inline-pill-gap">Pre-Alpha</span></h2>
                <p class="project-kicker">Free, original, Australian-inspired tactical multiplayer FPS</p>
              </div>
            </div>
            <div class="button-row">
              <a href="https://theantipopau.github.io/southernspear-site/" target="_blank" rel="noopener noreferrer" class="button primary">Dev Site</a>
              <a href="https://github.com/theantipopau/SouthernSpear" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
            </div>
          </div>

          <div class="pill-row">
            <span class="pill brand">Unreal Engine 5.8</span>
            <span class="pill brand">Lyra Starter Game</span>
            <span class="pill soft">C++20</span>
            <span class="pill soft">Free to Play</span>
            <span class="pill warm">Planned for Steam</span>
          </div>

          <p>
            <em class="accent-italic">One life. One objective. Every rank earned.</em> Southern Spear is a
            tactical shooter built on Unreal Engine 5.8 and the Lyra Starter Game, following the design
            philosophy of the classic <em>America's Army</em> games: slow, deliberate, team-first combat where
            positioning and communication beat reflexes — and where every rank is earned in the field rather
            than bought.
          </p>

          <div class="project-columns">
            <div>
              <h4>What It Is</h4>
              <ul>
                <li>An entirely original Australian-inspired setting — outback theatres, asymmetric objectives, and a faction structure built around small-unit tactics.</li>
                <li>Free to play by design, with no planned progression shortcuts: unlocks follow demonstrated skill, mirroring the source inspiration.</li>
                <li>Pre-alpha and in active development, with a public roadmap and a rolling changelog — no playable release, download, or release date announced yet.</li>
              </ul>
            </div>
            <div>
              <h4>How It's Built</h4>
              <ul>
                <li>C++20 gameplay code on top of Lyra's modular gameplay framework — ability system, weapon layering, and game mode assembly reused rather than reinvented.</li>
                <li>The development repository stays private; the public site, changelog, roadmap, and press kit are <em>generated</em> from it by a publish script, so engine and game content are never exposed.</li>
                <li>Every working session gets a changelog entry — the same "document the trade-off" discipline used on the client and open-source work here.</li>
              </ul>
            </div>
          </div>

          <div class="related-links">
            <p>Follow the build</p>
            <ul>
              <li><a href="https://theantipopau.github.io/southernspear-site/" target="_blank" rel="noopener noreferrer">Southern Spear website &amp; development portal</a></li>
              <li><a href="https://theantipopau.github.io/southernspear-site/changelog.html" target="_blank" rel="noopener noreferrer">Rolling development changelog</a></li>
              <li><a href="https://github.com/theantipopau/southernspear-site" target="_blank" rel="noopener noreferrer">Published site source (generated repo)</a></li>
            </ul>
          </div>
        </article>
      </section>

      <section class="project-grid" id="stars" data-category="case">
        <article class="project-card project-card-featured" data-project="stars pastoral care education azure pb4l tracking client delivery flagship">
          <div class="project-head">
            <div class="project-identity">
              <img src="/sophia-logo.png" alt="STARS logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">02 / Client Delivery</p>
                <h2>STARS</h2>
                <p class="project-kicker">Student Tracking and Recording System</p>
              </div>
            </div>
            <a href="https://demo.sophiastars.info" target="_blank" rel="noopener noreferrer" class="button secondary">Visit Demo</a>
          </div>

          <div class="pill-row">
            <span class="pill brand">Azure Authentication</span>
            <span class="pill soft">PB4L Framework</span>
            <span class="pill soft">Automated Communication</span>
            <span class="pill warm">Audit Trails</span>
          </div>

          <p>
            STARS is a pastoral care platform built for a school team that needed immediate visibility of student
            wellbeing, behavior trends, and intervention history — without relying on disconnected spreadsheets
            or manual, easily-lost processes.
          </p>

          <div class="project-columns">
            <div>
              <h4>What It Solves</h4>
              <ul>
                <li>Consolidates behavior, affirmations, and incident data into a unified record.</li>
                <li>Automates communication workflows with role-aware escalation paths.</li>
                <li>Gives leaders fast access to high-confidence operational information.</li>
              </ul>
            </div>
            <div>
              <h4>Design Choices</h4>
              <ul>
                <li>Role-based access for staff, leaders, and administrators.</li>
                <li>Privacy-first architecture with explicit governance controls.</li>
                <li>No public data exposure; demo environment uses synthetic information.</li>
              </ul>
            </div>
          </div>

          <div class="quote-box">
            <p class="mb-0">
              "STARS has made our processes significantly more streamlined and the immediacy of information for
              pastoral leaders has been exceptional."
            </p>
            <p class="muted mb-0 mt-3">Mr N, Pastoral Leader</p>
          </div>
        </article>
      </section>

      <section class="project-grid" id="omencore" data-category="oss">
        <article class="project-card project-card-featured" data-project="omencore 4.3.0 hp omen victus hardware thermals fan rgb dotnet fan curve safety update linux windows gpu overclock open source flagship architecture automation cli">
          <div class="project-head">
            <div class="project-identity">
              <img src="/omencore-logo.png" alt="OmenCore logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">03 / Open Source</p>
                <h2>OmenCore <a class="pill brand inline-pill-gap" href={omencoreRelease.url} target="_blank" rel="noopener noreferrer">{omencoreRelease.tag}</a></h2>
                <p class="project-kicker">Latest release {omencoreRelease.tag}{omencoreRelease.date && `, published ${omencoreRelease.date}`} — hardware control for HP OMEN and Victus laptops</p>
              </div>
            </div>
            <div class="button-row">
              <a href="https://omencore.info" target="_blank" rel="noopener noreferrer" class="button secondary">Website</a>
              <a href="https://github.com/theantipopau/omencore" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
            </div>
          </div>

          <div class="pill-row">
            <span class="star-badge" set:html={`${starIcon}<span data-count-to="${S('omencore')}">0</span>★`} />
            <span class="pill brand">.NET 8</span>
            <span class="pill soft">Automation Rules Engine</span>
            <span class="pill soft">Windows CLI</span>
            <span class="pill warm">No Outbound Telemetry</span>
          </div>

          <p>
            OmenCore replaces bloated OEM control software with direct hardware controls for fan behavior, thermals,
            power modes, undervolting, and RGB management. With {S('omencore')}+ GitHub stars and an active issue
            tracker, it has shipped 80+ releases since December 2025 — the latest, {omencoreRelease.tag}, landed
            {omencoreRelease.date} — each one traced back to real hardware, not a roadmap slide.
          </p>

          <div class="release-panel">
            <div>
              <span class="release-label">Latest release</span>
              <strong>{omencoreRelease.tag}{omencoreRelease.date && ` — published ${omencoreRelease.date}`} — Windows installer and portable builds plus Linux CLI &amp; GUI, all checksummed in the release notes</strong>
            </div>
            <div>
              <span class="release-label">Release history</span>
              <strong>80+ releases since v1.0.0 in December 2025 — the 4.3.x cycle added the automation engine, the Windows CLI, and the OmenCore.Core extraction</strong>
            </div>
            <div>
              <span class="release-label">Convention</span>
              <strong>Unconfirmed-on-real-hardware fixes are labeled, not claimed done</strong>
            </div>
          </div>

          <div class="project-columns">
            <div>
              <h4>v4.3.0 Highlights</h4>
              <ul>
                <li>Shipped all 7 backend automation trigger types (temperature, idle, process, WiFi network, time, battery, AC power) plus a new lid-close trigger — four had been implemented but deliberately held back for undocumented reasons, two of them with real bugs fixed before promotion.</li>
                <li>New <code>omencore-cli</code> Windows command-line tool — <code>status</code>, <code>fan</code>, <code>performance</code>, <code>keyboard</code>, <code>monitor</code>, <code>config</code>, and <code>daemon</code> — built on the same hardware layer as the GUI, no duplicated logic.</li>
                <li>Extracted 194 files into a standalone <code>OmenCore.Core</code> library, decoupling the hardware/service layer from WPF — the precondition the CLI (and any future headless mode) needed to exist at all.</li>
              </ul>
            </div>
            <div>
              <h4>Real Bugs Fixed From Field Reports</h4>
              <ul>
                <li>A Quiet Safety Monitor temperature trip could silently cascade into switching the user's performance mode — despite its own log message promising the power mode was "retained."</li>
                <li>Built-in RGB "Night Mode" and "Work" lighting scenes silently overrode manually-configured lighting on a hidden schedule, with zero UI to see or disable it — fixed after a Discord report of a keyboard "randomly" turning orange.</li>
                <li>Power Automation force-applied the configured AC/Battery preset on every startup regardless of whether the power source had changed, silently discarding a user's manual mid-session choice.</li>
              </ul>
            </div>
          </div>

          <div class="related-links">
            <p>Source notes</p>
            <ul>
              <li><a href={omencoreRelease.url} target="_blank" rel="noopener noreferrer">OmenCore {omencoreRelease.tag} release notes</a></li>
              <li><a href="https://github.com/theantipopau/omencore/releases" target="_blank" rel="noopener noreferrer">All OmenCore releases</a></li>
              <li><a href="https://github.com/theantipopau/omencore/blob/main/README.md" target="_blank" rel="noopener noreferrer">Current OmenCore README</a></li>
            </ul>
          </div>
        </article>
      </section>

      <section class="project-grid" id="pccompanion" data-category="case">
        <article class="project-card project-card-featured" data-project="pccompanion radium pcs companion windows telemetry diagnostics maintenance tauri rust react thermal tray support sensor sidecar copilot local llm client product flagship">
          <div class="project-head">
            <div class="project-identity">
              <img src="/radium-logo.png" alt="Radium PCs Companion logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">04 / Client Product</p>
                <h2>Radium PCs Companion <a class="pill warm inline-pill-gap" href={radiumRelease.url} target="_blank" rel="noopener noreferrer">{radiumRelease.tag}</a></h2>
                <p class="project-kicker">Local-first Windows telemetry, diagnostics, and maintenance companion</p>
              </div>
            </div>
            <a href="https://github.com/theantipopau/pccompanion" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
          </div>

          <div class="pill-row">
            <span class="pill brand">Tauri 2 + React 19</span>
            <span class="pill brand">Rust Backend</span>
            <span class="pill soft">Truthful Telemetry</span>
            <span class="pill warm">Local-First</span>
          </div>

          <p>
            Built for Radium PCs customers and technicians, this desktop companion pairs a premium React interface
            with a Rust/Tauri backend, vendor telemetry providers, and a bundled sensor sidecar for hardware that
            needs deeper package-temperature access than user-mode WMI exposes. v0.3 was a deliberate premium-feel
            and reliability pass — no changes to telemetry providers, native write paths, or the safety-gating model.
          </p>

          <div class="project-columns">
            <div>
              <h4>What It Delivers</h4>
              <ul>
                <li>Live dashboard for CPU, GPU, RAM, network, storage, and support-readiness state.</li>
                <li>Premium thermal visualization with vendor-aware component overlays.</li>
                <li>Maintenance tools — bloatware review, registry checks, startup manager, RAM optimizer — and Quiet/Balanced/Creator/Gaming performance profiles.</li>
              </ul>
            </div>
            <div>
              <h4>v0.3 Reliability Pass</h4>
              <ul>
                <li>Fixed a rare panic in the 1Hz hardware monitor loop that could poison a lock and permanently stop telemetry until restart — the loop now recovers instead of cascading.</li>
                <li>Unified every hover/press/transition animation in the app onto one consistent motion system, replacing over a dozen slightly-different one-off timings.</li>
                <li>Truthful telemetry — missing sensors show as degraded or driver-required, never fabricated as zero.</li>
                <li>Fan/EC/firmware writes stay blocked until model-specific safety validation exists.</li>
              </ul>
            </div>
          </div>

          <div class="note">
            <strong>Status:</strong> Public release at v0.3 for Windows 10/11 x64. GPU-vendor-provider expansion,
            sensor-sidecar packaging, and a real in-game frame-time overlay are reviewed and deliberately deferred
            pending access to real target hardware to validate against.
          </div>
        </article>
      </section>
    </section>

    <section class="section reveal">
      <div class="section-head">
        <p class="eyebrow">More Case Studies</p>
        <h2>Live products and systems in active development</h2>
      </div>

      <section class="project-grid" id="gridpilot" data-category="oss dev">
        <article class="project-card" data-project="gridpilot timetabling school education local-first python ollama tfx sfx offline data analysis coaching">
          <div class="project-head">
            <div class="project-identity">
              <img src="/projects/gridpilot.png" alt="GridPilot logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <h2>GridPilot <span class="pill soft inline-pill-gap">Active Development</span></h2>
                <p class="project-kicker">A local-first co-pilot for school timetabling</p>
              </div>
            </div>
            <a href="https://github.com/theantipopau/GridPilot" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
          </div>
          <div class="pill-row">
            <span class="pill brand">Python 3.11+</span>
            <span class="pill brand">Node</span>
            <span class="pill soft">256 Tests Passing</span>
            <span class="pill warm">Runs Fully Offline</span>
          </div>
          <p>
            Built to sit <em>alongside</em> Timetabling Solutions, not replace it: load a school's real
            <code>.tfx</code>/<code>.sfx</code> export, see the whole timetable, get a deterministic list of what's
            actually wrong with it — clashes, capacity, staff load, composite classes — propose and validate fixes
            without ever touching the source data, then export an approved change back out as a file the existing
            system can re-read.
          </p>
          <div class="project-columns">
            <div>
              <h4>What It Does</h4>
              <ul>
                <li>Ingests and analyses real timetabling exports, surfacing conflicts as a deterministic, auditable findings list.</li>
                <li>Proposes edits, validates them against the same rules, and round-trips an approved file back out.</li>
                <li>Nothing calls a cloud API — every byte stays on the machine it ran on.</li>
              </ul>
            </div>
            <div>
              <h4>Privacy Choices</h4>
              <ul>
                <li>Timetable data is student- and staff-adjacent: it never leaves the local machine by design.</li>
                <li>The single AI layer is local-only (Ollama), and it is used for <em>explaining</em> findings in plain language — never for generating or mutating schedule data.</li>
                <li>256 passing tests cover the import, validation, and export path end to end.</li>
              </ul>
            </div>
          </div>
        </article>
      </section>

      <section class="project-grid" id="aethercontrol" data-category="oss dev">
        <article class="project-card project-card-featured" data-project="aether control winui3 dotnet hardware monitoring portrait mode rgb corsair openrgb windows optimisation fan control plugin framework wip active development">
          <div class="project-head">
            <div class="project-identity">
              <img src="/projects/aether-control.png" alt="Aether Control logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <h2>Aether Control <span class="pill soft inline-pill-gap">Active Development</span></h2>
                <p class="project-kicker">All-in-one control suite for custom gaming PCs</p>
              </div>
            </div>
            <a href="https://github.com/theantipopau/aether-control" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
          </div>
          <div class="pill-row">
            <span class="pill brand">WinUI 3 + .NET 8</span>
            <span class="pill soft">Plugin Framework</span>
            <span class="pill warm">Direct-HID RGB</span>
          </div>
          <p>
            A hardware dashboard, a real portrait-display mode, a Windows optimisation centre, and RGB control —
            in one clean, unpackaged app instead of four separate vendor tools fighting each other in the
            background. Rather than re-deriving sensor behavior from scratch, the parts that needed real-hardware
            validation were ported straight from proven code in OmenCore, Portrait Stats, and Radium PCs Companion.
          </p>
          <div class="project-columns">
            <div>
              <h4>What's Shipped So Far</h4>
              <ul>
                <li>Full CPU, GPU, RAM, storage, motherboard, and network dashboard with radial gauges, sparkline history, and tone-based severity coloring.</li>
                <li>Portrait Mode — a complete port of Portrait Stats' layout, not a stub, with drag-to-monitor and one-click fill.</li>
                <li>An Optimisation Centre with fan control that reads <em>and writes</em> PWM headers directly, a 20% safety floor, and automatic revert to BIOS control on exit.</li>
                <li>Direct-HID Corsair RGB control with no iCUE or OpenRGB required, plus an OpenRGB fallback for everything else.</li>
              </ul>
            </div>
            <div>
              <h4>Design Principles</h4>
              <ul>
                <li>"Confidently wrong is worse than honestly unavailable" — a sensor that doesn't exist on a given board gets hidden, never a plausible-looking fake number.</li>
                <li>Anything touching live hardware state stays reversible: fan control always reverts to automatic on exit, memory optimisation never terminates a process.</li>
                <li>A plugin framework (<code>IAetherPlugin</code>) loads each module into its own collectible <code>AssemblyLoadContext</code> — add or remove one without restarting the app.</li>
                <li>Undervolting and HP-style BIOS checking were deliberately left out of scope, documented in the roadmap as "why not," not just "later."</li>
              </ul>
            </div>
          </div>
          <div class="note">
            <strong>Status:</strong> Actively being built in tracked phases, with an honest public roadmap of what's
            shipped, what's deliberately deferred, and why. No packaged release yet.
          </div>
        </article>
      </section>

      <section class="project-grid" id="xteve" data-category="oss live">
        <article class="project-card" data-project="xteve reborn xteve m3u epg plex dvr emby jellyfin iptv proxy go fork self-update">
          <div class="project-head">
            <div class="project-identity">
              <img src="/projects/xteve-reborn.png" alt="xTeVe Reborn logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <h2>xTeVe Reborn</h2>
                <p class="project-kicker">Modernised M3U/EPG proxy for Plex DVR, Emby, and Jellyfin Live TV</p>
              </div>
            </div>
            <div class="button-row">
              <a href="https://theantipopau.github.io/xteve-reborn/" target="_blank" rel="noopener noreferrer" class="button secondary">Website</a>
              <a href="https://github.com/theantipopau/xteve-reborn" target="_blank" rel="noopener noreferrer" class="button secondary">GitHub</a>
            </div>
          </div>
          <div class="pill-row">

      '@type': 'SoftwareApplication',
      name: 'Radium PCs Companion',
      applicationCategory: 'UtilitiesApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'MouseTune',
      applicationCategory: 'UtilitiesApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'PageCue',
      applicationCategory: 'LifestyleApplication'
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Steam Launch Utilities',
      applicationCategory: 'UtilitiesApplication'
    }
  ]

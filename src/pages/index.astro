---
import Layout from '../layouts/Layout.astro';

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'matthurley.dev',
      url: 'https://matthurley.dev',
      logo: 'https://matthurley.dev/brand/icon-512.png',
      founder: {
        '@type': 'Person',
        name: 'Matt Hurley'
      },
      sameAs: [
        'https://github.com/theantipopau',
        'https://www.linkedin.com/in/matt-hurley-29471a149/'
      ]
    },
    {
      '@type': 'Person',
      name: 'Matt Hurley',
      url: 'https://matthurley.dev/about',
      jobTitle: 'Software Engineer & Principal',
      sameAs: [
        'https://github.com/theantipopau',
        'https://www.linkedin.com/in/matt-hurley-29471a149/'
      ]
    },
    {
      '@type': 'WebSite',
      name: 'matthurley.dev',
      url: 'https://matthurley.dev'
    }
  ]
};
---

<Layout
  title="matthurley.dev | Practical, Privacy-First Software"
  description="matthurley.dev designs and ships practical, privacy-first software for education, hardware, and operations teams — built by an engineer who also runs the operations these systems support."
  jsonLd={homeJsonLd}
>
  <div class="container page-shell">
    <section class="page-hero hero-split reveal">
      <div class="hero-copy">
        <p class="eyebrow">matthurley.dev</p>
        <h1>Software built for the real world, not just the demo.</h1>
        <p class="lead">
          I design, build, and maintain practical systems for schools, hardware makers, and small teams —
          under real constraints, with privacy built in from the first line, not bolted on before launch.
        </p>
        <div class="button-row mt-4">
          <a href="/contact" class="button primary">Start a project</a>
          <a href="/projects" class="button secondary">See the work</a>
        </div>
      </div>
      <div class="hero-panel">
        <div class="hero-panel-head">
          <span>status.json</span>
          <span>currently building</span>
        </div>
        <div class="hero-stat-list">
          <div class="hero-stat">
            <span class="stat-value">200+</span>
            <span class="stat-label">GitHub stars across open-source releases, earned on sustained reliability work, not launch-week hype</span>
          </div>
          <div class="hero-stat">
            <span class="stat-value">11+ yrs</span>
            <span class="stat-label">Operational leadership shaping every delivery and governance decision</span>
          </div>
          <div class="hero-stat">
            <span class="stat-value">Zero</span>
            <span class="stat-label">Default tracking across every platform shipped to date</span>
          </div>
        </div>
      </div>
    </section>

    <section class="trust-strip reveal">
      <span>Education Platforms</span>
      <span>Hardware & Telemetry</span>
      <span>Privacy-First Architecture</span>
      <span>Field-Tested Reliability</span>
      <span>Desktop & Web Delivery</span>
    </section>

    <section class="section reveal">
      <div class="section-head">
        <p class="eyebrow">What I Do</p>
        <h2>Four ways I earn a place in your stack</h2>
        <p class="lead">Every engagement starts from the same question: what does this system actually need to survive contact with real users and real constraints?</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card">
          <span class="feature-icon">01</span>
          <h3>Product Engineering</h3>
          <p>Full-stack builds from spec to shipped software — web, desktop, and mobile — with architecture decisions documented as you go, not reverse-engineered later.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">02</span>
          <h3>Systems & Reliability</h3>
          <p>Field-driven maintenance and hardening for software already in production, where the next release is judged by what it fixes, not what it demos.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">03</span>
          <h3>Privacy-First Architecture</h3>
          <p>Governance-aware systems with explicit access boundaries and audit trails, built for environments — schools, small operators — where trust is the product.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">04</span>
          <h3>Hardware-Adjacent Software</h3>
          <p>Desktop applications that talk to real hardware and telemetry honestly — a missing sensor reads as unavailable, never faked as zero.</p>
        </div>
      </div>
    </section>

    <section class="section reveal">
      <div class="section-head">
        <p class="eyebrow">Selected Work</p>
        <h2>Three systems, three different constraints</h2>
        <p class="lead">A school platform trusted with real student wellbeing data, a hardware utility with an active community, and a client-facing desktop product built to tell the truth about what it measures.</p>
      </div>
      <div class="project-grid">
        <article class="project-card project-card-featured">
          <div class="project-head">
            <div class="project-identity">
              <img src="/sophia-logo.png" alt="STARS logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">01 / Client Delivery</p>
                <h3>STARS</h3>
                <p class="project-kicker">Student Tracking and Recording System</p>
              </div>
            </div>
            <a href="/projects#stars" class="button secondary">View case study</a>
          </div>
          <p>A pastoral care platform built for school operations with role-based access, automated workflows, and complete audit visibility — replacing disconnected spreadsheets with one governed source of truth.</p>
          <div class="pill-row">
            <span class="pill brand">Azure Auth</span>
            <span class="pill soft">PB4L Workflow</span>
            <span class="pill warm">Audit Trails</span>
          </div>
          <div class="quote-box mt-4">
            <p class="mb-0">"STARS has made our processes significantly more streamlined and the immediacy of information for pastoral leaders has been exceptional."</p>
            <p class="muted mb-0 mt-3">Mr N, Pastoral Leader</p>
          </div>
        </article>

        <article class="project-card">
          <div class="project-head">
            <div class="project-identity">
              <img src="/omencore-logo.png" alt="OmenCore logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">02 / Open Source</p>
                <h3>OmenCore <span class="pill brand inline-pill-gap">v4.0.0</span></h3>
                <p class="project-kicker">Hardware control center for HP OMEN and Victus laptops</p>
              </div>
            </div>
            <a href="/projects#omencore" class="button secondary">View case study</a>
          </div>
          <p>184+ GitHub stars and 13 field-driven releases since April, capped by a v4.0.0 that paid down architecture debt instead of chasing new features — 953/953 tests passing, zero build warnings.</p>
          <div class="pill-row">
            <span class="pill brand">.NET 8</span>
            <span class="pill soft">Fan Safety</span>
            <span class="pill warm">No Outbound Telemetry</span>
          </div>
        </article>

        <article class="project-card">
          <div class="project-head">
            <div class="project-identity">
              <img src="/radium-logo.png" alt="Radium PCs Companion logo" class="project-logo" loading="lazy" decoding="async">
              <div>
                <p class="case-index">03 / Client Product</p>
                <h3>Radium PCs Companion <span class="pill warm inline-pill-gap">v0.3</span></h3>
                <p class="project-kicker">Local-first Windows telemetry and maintenance companion</p>
              </div>
            </div>
            <a href="/projects#pccompanion" class="button secondary">View case study</a>
          </div>
          <p>A premium desktop companion built for a real PC-building business — live thermal telemetry, maintenance tools, and a hard rule: a missing sensor is reported as missing, never fabricated as zero.</p>
          <div class="pill-row">
            <span class="pill brand">Tauri 2 + Rust</span>
            <span class="pill soft">Truthful Telemetry</span>
            <span class="pill warm">Local-First</span>
          </div>
        </article>
      </div>
      <div class="button-row">
        <a href="/projects" class="button secondary">See all work</a>
      </div>
    </section>

    <section class="section reveal">
      <div class="section-head">
        <p class="eyebrow">How I Work</p>
        <h2>Three principles that shape every engagement</h2>
      </div>
      <div class="process-grid">
        <div class="process-step">
          <p class="process-number">01</p>
          <h3>Understand the constraints first</h3>
          <p>Requirements are the easy part. Governance, staffing reality, and who actually has to operate this at 4pm on a Friday matter more than the feature list.</p>
        </div>
        <div class="process-step">
          <p class="process-number">02</p>
          <h3>Build in small, reviewable increments</h3>
          <p>Narrow, frequent releases beat big rare ones. Every change should be small enough that you — or I — can actually explain why it works.</p>
        </div>
        <div class="process-step">
          <p class="process-number">03</p>
          <h3>Maintain like it matters after launch</h3>
          <p>Software is judged on release two through twenty, not release one. Reliability, honest telemetry, and support are part of the build, not an afterthought.</p>
        </div>
      </div>
    </section>

    <section class="surface reveal">
      <div class="hero-split">
        <div>
          <p class="eyebrow">About</p>
          <h2>Led by an engineer who also runs the operations his software supports</h2>
          <p class="muted mb-0">
            I split my time between senior leadership at a school in South East Queensland and building the
            software that leadership actually needs. That dual seat — user and builder — is why the systems
            here are designed around real operational pressure instead of a clean-room spec.
          </p>
        </div>
        <div class="button-row self-end">
          <a href="/about" class="button secondary">Read the full story</a>
        </div>
      </div>
    </section>

    <section class="support-banner reveal">
      <p class="eyebrow">Start Here</p>
      <h2 class="mb-3">Have a system that needs to hold up under real conditions?</h2>
      <p class="muted">Tell me what it needs to do and who has to rely on it. I'll tell you honestly whether it's a fit.</p>
      <div class="button-row mt-3">
        <a href="/contact" class="button primary">Start a project</a>
        <a href="/writing" class="button secondary">Read the writing</a>
      </div>
    </section>
  </div>
</Layout>

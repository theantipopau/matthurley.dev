---
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
---

{variant === 'mark' ? (
  <svg viewBox="0 0 512 512" width="512" height="512" class={className} role="img" aria-label="matthurley.dev">
    <rect width="512" height="512" rx="104" fill="#332f2b"></rect>
    <text x="256" y="272" text-anchor="middle" font-family="'JetBrains Mono', 'IBM Plex Mono', ui-monospace, Menlo, monospace" font-weight="700" font-size="150" letter-spacing="-4">
      <tspan fill="var(--brand, #d97b45)">&lt;</tspan><tspan fill="#f5f1e8">MH</tspan><tspan fill="var(--brand, #d97b45)">/&gt;</tspan>
    </text>
    <rect x="216" y="322" width="80" height="18" rx="4" fill="var(--brand, #d97b45)"></rect>
  </svg>
) : (
  <svg viewBox="0 0 640 160" width="640" height="160" class={className} role="img" aria-label="matthurley.dev">
    <rect x="20" y="20" width="120" height="120" rx="26" fill="#332f2b"></rect>
    <text x="80" y="99" text-anchor="middle" font-family="'JetBrains Mono', 'IBM Plex Mono', ui-monospace, Menlo, monospace" font-weight="700" font-size="38" letter-spacing="-1">
      <tspan fill="var(--brand, #d97b45)">&lt;</tspan><tspan fill="#f5f1e8">MH</tspan><tspan fill="var(--brand, #d97b45)">/&gt;</tspan>
    </text>
    <rect x="60" y="112" width="40" height="8" rx="3" fill="var(--brand, #d97b45)"></rect>
    <text x="164" y="93" font-family="'JetBrains Mono', 'IBM Plex Mono', ui-monospace, Menlo, monospace" font-weight="700" font-size="46" letter-spacing="-1">
      <tspan fill="currentColor">matthurley</tspan><tspan fill="var(--brand, #d97b45)">.dev</tspan>
    </text>
  </svg>
)}
